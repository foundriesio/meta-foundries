c_boot05() {
	EXP="EFI system partition discoverable with a boot binary (BSP-specific expectations provisional)"
	[ "$1" = describe ] && return
	_mi=$(p /proc/self/mountinfo)
	_esp=$(awk '{ n=0; for (i=7;i<=NF;i++) if ($i=="-") { n=i; break } if (n && $(n+1)=="vfat") print $5 }' "$_mi" 2>/dev/null | head -n 5)
	_found=""
	for _m in $_esp; do
		for _b in "$_m"/EFI/BOOT/BOOT*.EFI "$_m"/EFI/BOOT/boot*.efi; do
			[ -f "$(p "$_b")" ] 2>/dev/null && _found="$_found $_b"
		done 2>/dev/null
	done
	# Glob above runs on unprefixed paths; repeat under the test root.
	if [ -z "$_found" ] && [ -n "$R" ]; then
		for _m in $_esp; do
			for _b in "$R$_m"/EFI/BOOT/*.[Ee][Ff][Ii]; do [ -f "$_b" ] && _found="$_found ${_b#"$R"}"; done
		done
	fi
	_ld=""; [ -e "$(p /boot/loader)" ] && _ld="/boot/loader present"
	EVID="vfat mounts: ${_esp:-none}; ${_ld:-/boot/loader absent}"
	if [ -n "$_found" ]; then RES=PASS; OBS="boot binary:$_found"; SUMMARY="ESP and boot binary found"
	elif [ -z "$_esp" ]; then RES=UNKNOWN; OBS="no ESP mounted; not mounted by the suite"; SUMMARY="ESP not mounted"
