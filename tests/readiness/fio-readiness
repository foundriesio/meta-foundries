# ---------------------------------------------------------------------------
# Report

INTERRUPTED=""

write_report() {
	_end=$(now_utc)
	_end_s=$(date +%s 2>/dev/null || echo 0)
	_model=$(tr -d '\0' <"$(p /sys/firmware/devicetree/base/model)" 2>/dev/null || cat "$(p /sys/class/dmi/id/product_name)" 2>/dev/null)
	_osid=$(sed -n 's/^PRETTY_NAME=//p' "$(p /etc/os-release)" 2>/dev/null | tr -d '"')
	{
		printf 'meta-foundries readiness report\n'
		[ -n "$INTERRUPTED" ] && printf '*** INCOMPLETE: run interrupted; unlisted checks were not executed and did not pass ***\n'
		printf 'Suite: %s  Check definitions: %s\n' "$SUITE_VERSION" "$DEFS_REVISION"
		printf 'Started: %s  Ended: %s  Duration: %ss\n' "$START" "$_end" "$((_end_s - START_S))"
		if [ "$PROFILE" = full ]; then printf 'Profile: Full Update%s\n' "$PROFILE_NOTE"
		else printf 'Profile: OS Update. Container checks are outside this profile and omitted.\n'; fi
		[ -n "$CONTAINER_NOTE" ] && printf '%s\n' "$CONTAINER_NOTE"
		printf 'Host: %s  Model: %s\n' "$HOST" "${_model:-unknown}"
		printf 'Architecture: %s  Kernel: %s\n' "$(uname -m 2>/dev/null)" "$(uname -r 2>/dev/null)"
		printf 'Image: %s\n' "${_osid:-unknown}"
		printf 'Overrides: client=%s (%s) state-dir=%s (%s) timeout=%ss\n' "$CLIENT" "$CLIENT_SRC" "$STATE_DIR" "$STATE_SRC" "$QTIMEOUT"
		printf '\nReadiness inspection only. Updates, registration, firmware application and\n'
		printf 'recovery were not exercised. A PASS establishes only the stated condition.\n'
		printf 'Testing can leave the device in an unknown state; restore a known-good image\n'
		printf 'afterward if you need one.\n\n'
		printf '%-16s %-16s %-9s %-8s %s\n' ID CAPABILITY SCOPE RESULT SUMMARY
		while read -r _id; do
			_m="$WORK/res/$_id.meta"
			printf '%-16s %-16s %-9s %-8s %s\n' "$_id" "$(sed -n 's/^CAP=//p' "$_m")" \
				"$(sed -n 's/^SCOPE=//p' "$_m")" "$(sed -n 's/^RESULT=//p' "$_m")" "$(sed -n 's/^SUMMARY=//p' "$_m")"
		done <"$ORDER"
		printf '\nCounts:'
		for _s in PASS FAIL BLOCKED UNKNOWN; do
			printf ' %s=%s' "$_s" "$(cat "$WORK"/res/*.meta 2>/dev/null | grep -c "^RESULT=$_s\$")"
		done
		printf '\n\n'
		while read -r _id; do cat "$WORK/res/$_id.detail"; done <"$ORDER"
	} >"$WORK/report.txt"
	if cp "$WORK/report.txt" "$REPORT" 2>/dev/null; then
		rm -f "$PARTIAL"
		printf '\nReport: %s\n' "$REPORT"
	else
		printf '\nReport could not be written to %s; full report follows.\n\n' "$REPORT"
		cat "$WORK/report.txt"
	fi
}

cleanup() { rm -rf "$WORK"; }

on_signal() {
	INTERRUPTED=1
	trap - INT TERM HUP
	write_report
	cleanup
	exit 130
}
trap on_signal INT TERM HUP

