docker_client() { DOCKER_HOST=$NO_DAEMON DOCKER_CONTEXT="" q "$@"; }

c_app01() {
	EXP="docker, dockerd and the Compose plugin installed and answer client-only version queries"
	[ "$1" = describe ] && return
	_miss="" _ev=""
	if DOCKER_BIN=$(find_bin docker); then
		docker_client "$(p "$DOCKER_BIN")" --version; _ev="$_ev$ docker --version (exit $QRC): $QALL
"; [ "$QRC" -eq 0 ] || _miss="$_miss docker(query)"
	else DOCKER_BIN=""; _miss="$_miss docker"; fi
	if _dd=$(find_bin dockerd); then
		q "$(p "$_dd")" --version; _ev="$_ev$ dockerd --version (exit $QRC): $QALL
"; [ "$QRC" -eq 0 ] || _miss="$_miss dockerd(query)"
	else _miss="$_miss dockerd"; fi
	_cp=""
	for _c in /usr/libexec/docker/cli-plugins/docker-compose /usr/lib/docker/cli-plugins/docker-compose \
		/usr/local/lib/docker/cli-plugins/docker-compose /usr/bin/docker-compose; do
		[ -x "$(p "$_c")" ] && { _cp=$_c; break; }
	done
	if [ -n "$_cp" ]; then
		docker_client "$(p "$_cp")" version; _ev="$_ev$ $_cp version (exit $QRC): $QALL
"; [ "$QRC" -eq 0 ] || _miss="$_miss compose(query)"
	else _miss="$_miss compose-plugin"; fi
	EVID=$_ev
	NOTE="client queries run with DOCKER_HOST pointed at a nonexistent socket so they cannot start dockerd"
	if [ -z "$_miss" ]; then RES=PASS; OBS="docker, dockerd, compose plugin ($_cp)"; SUMMARY="Docker and Compose installed"
	else RES=FAIL; OBS="missing or failing:$_miss"; SUMMARY="Docker incomplete:$_miss"; fi
}

c_app02() {
	EXP="docker.service enabled and active; local socket answers a server version query"
	[ "$1" = describe ] && return
	unit_show -p UnitFileState -p ActiveState -p SubState docker.service
	_uf=$(prop UnitFileState); _as=$(prop ActiveState)
	_svc=$SHOW
	unit_show -p UnitFileState -p ActiveState docker.socket
	EVID="docker.service: $(printf '%s' "$_svc" | tr '\n' ' ')
docker.socket: $(printf '%s' "$SHOW" | tr '\n' ' ')"
	OBS="docker.service UnitFileState=${_uf:-?} ActiveState=${_as:-?}"
	case "$_uf" in enabled|enabled-runtime) ;; *) RES=FAIL; SUMMARY="docker.service not enabled"; return ;; esac
	if [ "$_as" != "active" ]; then
		RES=FAIL; SUMMARY="docker.service enabled but not running"
		NOTE="socket not queried: a request would socket-activate dockerd"
		return
	fi
	DOCKER_HOST=$DOCKER_SOCK DOCKER_CONTEXT="" q "$(p "$DOCKER_BIN")" version --format '{{.Server.Version}}'
	EVID="$EVID
$ docker version --format {{.Server.Version}} (exit $QRC): $QALL"
	if [ "$QRC" -eq 0 ] && [ -n "$QRAW" ]; then RES=PASS; OBS="$OBS; server $QOUT"; SUMMARY="dockerd running"
	else RES=FAIL; OBS="$OBS; server query failed (exit $QRC)"; SUMMARY="daemon not answering"; fi
}

c_app03() {
	EXP="effective storage driver overlay2 with containerd-snapshotter disabled (layer default)"
	_static=""
	for _f in /etc/docker/daemon.json /usr/lib/docker/daemon.json; do
		if [ -r "$(p "$_f")" ]; then
			_sd=$(grep -o '"storage-driver"[[:space:]]*:[[:space:]]*"[^"]*"' "$(p "$_f")" 2>/dev/null | sed 's/.*"\([^"]*\)"$/\1/')
			_cs=$(grep -o '"containerd-snapshotter"[[:space:]]*:[[:space:]]*[a-z]*' "$(p "$_f")" 2>/dev/null | sed 's/.*:[[:space:]]*//')
			_static="$_static$_f: storage-driver=${_sd:-unset} containerd-snapshotter=${_cs:-unset}
"
		else
			_static="$_static$_f: absent
"
		fi
	done
	EVID="static configuration (precedence /etc over /usr/lib; text extraction, not a JSON parser):
$_static"
	[ "$1" = describe ] && return
	DOCKER_HOST=$DOCKER_SOCK DOCKER_CONTEXT="" q "$(p "$DOCKER_BIN")" info --format '{{.Driver}}|{{.DockerRootDir}}|{{.DriverStatus}}'
	EVID="$EVID
$ docker info --format ... (exit $QRC): $QALL"
	_drv=$(printf '%s' "$QRAW" | head -n 1 | cut -d'|' -f1)
	OBS="effective driver: ${_drv:-unknown}"
	if [ "$QRC" -ne 0 ]; then RES=UNKNOWN; SUMMARY="effective configuration not readable"
	elif [ "$_drv" = "overlay2" ]; then RES=PASS; SUMMARY="overlay2, classic image store"
	else RES=FAIL; SUMMARY="storage driver $_drv"; fi
}

c_app04() {
	EXP="composectl installed; aklite-apps resolves to composectl; version query succeeds"
	[ "$1" = describe ] && return
	if ! COMPOSECTL_BIN=$(find_bin composectl); then RES=FAIL; OBS="composectl not found"; SUMMARY="composectl absent"; return; fi
	_ak=$(find_bin aklite-apps) || _ak=""
	_tgt=""; [ -n "$_ak" ] && _tgt=$(readlink "$(p "$_ak")" 2>/dev/null)
	docker_client "$(p "$COMPOSECTL_BIN")" version
	EVID="$ composectl version (exit $QRC): $QALL
aklite-apps: ${_ak:-absent} -> ${_tgt:-not a symlink}"
	OBS="$COMPOSECTL_BIN; aklite-apps ${_ak:-absent}"
	if [ -z "$_ak" ]; then RES=FAIL; SUMMARY="aklite-apps entrypoint absent"; return; fi
	case "$_tgt" in composectl|*/composectl) ;; *) RES=FAIL; SUMMARY="aklite-apps does not resolve to composectl"; return ;; esac
	if [ "$QRC" -eq 0 ]; then RES=PASS; SUMMARY="composectl and aklite-apps present"
	else RES=FAIL; SUMMARY="composectl version query failed"; fi
}

c_app05() {
	EXP="compose-app roots on persistent writable storage"
	[ "$1" = describe ] && return
	docker_client "$(p "$COMPOSECTL_BIN")" --help
	_store=$(printf '%s\n' "$QRAW" | sed -n 's/.*--store.*(default "\([^"]*\)").*/\1/p' | head -n 1)
	_compose=$(printf '%s\n' "$QRAW" | sed -n 's/.*--compose.*(default "\([^"]*\)").*/\1/p' | head -n 1)
	_store=${_store:-/var/sota/reset-apps}; _compose=${_compose:-/var/sota/compose-apps}
	_res=PASS _obs=""
	for _root in "$_compose" "$_store"; do
		judge_persist "$_root"
		_obs="${_obs}[$J_RES] $J_OBS
"
		case "$J_RES" in FAIL) _res=FAIL ;; UNKNOWN) [ "$_res" = PASS ] && _res=UNKNOWN ;; esac
	done
	EVID="roots from composectl --help defaults: compose=$_compose store=$_store"
	OBS=$_obs
	RES=$_res
	case "$RES" in PASS) SUMMARY="app roots persistent" ;; FAIL) SUMMARY="app roots not persistent" ;; *) SUMMARY="app root persistence ambiguous" ;; esac
	NOTE="preloaded content is not required"
}

